# App environment
APP_ENV=development
ENABLE_API_DOCS=true
ENABLE_ERROR_DETAILS=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URLs
FRONTEND_URL=http://localhost:5173
CLERK_AUTHORIZED_PARTY=http://localhost:5173

# Backend URLs
# Local host value: http://localhost:8000
# Docker backend-to-backend value: http://backend:8000
BACKEND_API_URL=http://backend:8000

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Clerk
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json

# Ollama
# Docker value for Ollama on the host machine:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Embedding API
EMBEDDING_PROVIDER=local
# Docker service URL:
EMBEDDING_API_URL=http://embedding_api:8001
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant
QDRANT_URL=https://your-qdrant-cluster.example
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=project_document_chunks
QDRANT_VECTOR_SIZE=384

# Supabase storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=project-documents

# GitHub
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPO_OWNER=optional-default-owner
GITHUB_REPO_NAME=optional-default-repo

# Slack
SLACK_BOT_TOKEN=replace-with-slack-bot-token

# MCP/internal service auth
INTERNAL_API_KEY=replace-with-long-random-internal-key
